+
+  describe("wallet sessions", () => {
+    it("issues a session for a valid raw ed25519 signature of the challenge", () => {
+      const challenge = ctx.service.issueSessionChallenge(CREATOR);
+      expect(challenge.message).toContain(CREATOR);
