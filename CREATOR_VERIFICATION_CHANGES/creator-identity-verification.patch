diff --git a/apps/web/src/app/api/creators/[address]/verification/email/route.ts b/apps/web/src/app/api/creators/[address]/verification/email/route.ts
new file mode 100644
index 00000000..fbe1da31
--- /dev/null
+++ b/apps/web/src/app/api/creators/[address]/verification/email/route.ts
@@ -0,0 +1,48 @@
+import { z } from "zod";
+import {
+  NO_STORE,
+  errorResponse,
+  readJson,
+  requireCreatorSession,
+  verificationService,
+  type CreatorRouteContext,
+} from "@/lib/creator-verification-http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+const schema = z.discriminatedUnion("action", [
+  z.object({ action: z.literal("start"), email: z.string().min(1).max(254) }).strict(),
+  z.object({ action: z.literal("confirm"), code: z.string().min(1).max(12) }).strict(),
+]);
+
+/**
+ * POST /api/creators/:address/verification/email
+ *
+ *   { "action": "start", "email": "..." }  → sends a 6-digit code to the email address
+ *   { "action": "confirm", "code": "123456" } → marks the step verified
+ *
+ * Requires a creator session (see ./session).
+ */
+export async function POST(request: Request, context: CreatorRouteContext) {
+  const auth = await requireCreatorSession(request, context);
+  if (auth instanceof Response) return auth;
+  const body = await readJson(request);
+  if (body instanceof Response) return body;
+  const parsed = schema.safeParse(body);
+  if (!parsed.success) {
+    return Response.json({ error: "Invalid request body" }, { status: 400, headers: NO_STORE });
+  }
+  try {
+    const service = verificationService();
+    if (parsed.data.action === "start") {
+      const dispatch = await service.startEmailVerification(auth.creator, parsed.data.email);
+      return Response.json({ dispatch, verification: service.getOwnerStatus(auth.creator) }, { status: 202, headers: NO_STORE });
+    }
+    const verification = await service.confirmEmailVerification(auth.creator, parsed.data.code);
+    return Response.json({ verification }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
diff --git a/apps/web/src/app/api/creators/[address]/verification/government-id/route.ts b/apps/web/src/app/api/creators/[address]/verification/government-id/route.ts
new file mode 100644
index 00000000..d72f674c
--- /dev/null
+++ b/apps/web/src/app/api/creators/[address]/verification/government-id/route.ts
@@ -0,0 +1,78 @@
+import { z } from "zod";
+import { authorizeAdminRequest } from "@/lib/admin-auth";
+import {
+  NO_STORE,
+  errorResponse,
+  readJson,
+  requireCreatorSession,
+  verificationService,
+  type CreatorRouteContext,
+} from "@/lib/creator-verification-http";
+import { GOVERNMENT_ID_DOCUMENT_TYPES } from "@/lib/creator-verification";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+const submitSchema = z.object({
+  documentType: z.enum(GOVERNMENT_ID_DOCUMENT_TYPES),
+  issuingCountry: z.string().min(2).max(2),
+  documentReference: z.string().min(4).max(256),
+}).strict();
+
+const reviewSchema = z.object({
+  decision: z.enum(["approve", "reject"]),
+  reviewer: z.string().min(1).max(128),
+  reason: z.string().max(500).optional(),
+}).strict();
+
+/**
+ * POST /api/creators/:address/verification/government-id
+ *
+ * Creator submits a government ID for review. Upload the document first via
+ * /api/presign-upload and pass the returned storage key as `documentReference`.
+ * Requires a creator session.
+ */
+export async function POST(request: Request, context: CreatorRouteContext) {
+  const auth = await requireCreatorSession(request, context);
+  if (auth instanceof Response) return auth;
+  const body = await readJson(request);
+  if (body instanceof Response) return body;
+  const parsed = submitSchema.safeParse(body);
+  if (!parsed.success) {
+    return Response.json(
+      { error: `Invalid request body. documentType must be one of ${GOVERNMENT_ID_DOCUMENT_TYPES.join(", ")}` },
+      { status: 400, headers: NO_STORE },
+    );
+  }
+  try {
+    const verification = await verificationService().submitGovernmentId(auth.creator, parsed.data);
+    return Response.json({ verification }, { status: 202, headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
+
+/**
+ * PATCH /api/creators/:address/verification/government-id
+ *
+ * Admin-only review: `{ "decision": "approve" | "reject", "reviewer": "...", "reason"?: "..." }`.
+ * Requires `Authorization: Bearer <ADMIN_API_KEY>`.
+ */
+export async function PATCH(request: Request, context: CreatorRouteContext) {
+  const denied = authorizeAdminRequest(request);
+  if (denied) return denied;
+  const body = await readJson(request);
+  if (body instanceof Response) return body;
+  const parsed = reviewSchema.safeParse(body);
+  if (!parsed.success) {
+    return Response.json({ error: "Invalid request body" }, { status: 400, headers: NO_STORE });
+  }
+  try {
+    const address = decodeURIComponent((await context.params).address);
+    const verification = await verificationService().reviewGovernmentId(address, parsed.data);
+    return Response.json({ verification }, { headers: NO_STORE });
+  } catch (error) {
+    return errorResponse(error);
+  }
+}
diff --git a/apps/web/src/app/api/creators/[address]/verification/government-id/upload/route.ts b/apps/web/src/app/api/creators/[address]/verification/government-id/upload/route.ts
new file mode 100644
index 00000000..b0bc2623
--- /dev/null
+++ b/apps/web/src/app/api/creators/[address]/verification/government-id/upload/route.ts
@@ -0,0 +1,61 @@
+import { z } from "zod";
+import {
+  ALLOWED_CONTENT_TYPES,
+  buildCreatorIdentityDocumentKey,
+  createPresignedPutUrl,
+  loadS3Config,
+  type AllowedContentType,
+} from "@/lib/s3";
+import { NO_STORE, readJson, requireCreatorSession, type CreatorRouteContext } from "@/lib/creator-verification-http";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+export const revalidate = 0;
+
+const schema = z.object({ contentType: z.enum(ALLOWED_CONTENT_TYPES) }).strict();
+
+/**
+ * POST /api/creators/:address/verification/government-id/upload
+ *
+ * Returns a short-lived pre-signed PUT URL for the creator's government ID
+ * document. Documents are stored under `creator-identity/<address>/` — a
+ * private prefix separate from public campaign evidence. Pass the returned
+ * `key` as `documentReference` when submitting the government ID step.
+ * Requires a creator session.
+ */
+export async function POST(request: Request, context: CreatorRouteContext) {
+  const auth = await requireCreatorSession(request, context);
+  if (auth instanceof Response) return auth;
+  const body = await readJson(request);
+  if (body instanceof Response) return body;
+  const parsed = schema.safeParse(body);
+  if (!parsed.success) {
+    return Response.json(
+      { error: `contentType must be one of ${ALLOWED_CONTENT_TYPES.join(", ")}` },
+      { status: 400, headers: NO_STORE },
+    );
+  }
+
+  let config;
+  try {
+    config = loadS3Config();
+  } catch (error) {
+    console.error("[creator-verification] S3 configuration error", error);
+    return Response.json({ error: "Document uploads are not configured" }, { status: 503, headers: NO_STORE });
+  }
+
+  try {
+    const contentType = parsed.data.contentType as AllowedContentType;
+    const result = createPresignedPutUrl(config, {
+      key: buildCreatorIdentityDocumentKey(auth.creator, contentType),
+      contentType,
+    });
+    return Response.json(
+      { url: result.url, key: result.key, contentType: result.contentType, expiresAt: result.expiresAt },
+      { headers: NO_STORE },
+    );
+  } catch (error) {
+    console.error("[creator-verification] presigning error", error);
+    return Response.json({ error: "Failed to generate upload URL" }, { status: 500, headers: NO_STORE });
+  }
+}
